layout {
    cwd "/Users/stephencouturier"
    tab name="RM" focus=true hide_floating_panes=true {
        pane cwd="Projects/risk-management"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="Services" hide_floating_panes=true {
        pane cwd="Projects/risk-management"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="Review" hide_floating_panes=true {
        pane split_direction="vertical" {
            pane cwd="Projects/risk-management" size="50%"
            pane cwd="Projects/risk-management" size="50%"
        }
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="DB" hide_floating_panes=true {
        pane cwd="Projects/risk-management"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="Misc" hide_floating_panes=true {
        pane focus=true
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="7:rules"  hide_floating_panes=true {
        pane cwd="Projects/rules-engine"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="8:wk1" hide_floating_panes=true {
        pane cwd="Projects/wk1"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    tab name="9:wk2" hide_floating_panes=true {
        pane cwd="Projects/wk2"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
    new_tab_template {
        pane split_direction="vertical"
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }
}
